        case '9': {uint8_t a[5]={0x06,0x49,0x49,0x29,0x1E}; memcpy(columnas,a,5); break;}

        case '.': {uint8_t a[5]={0,0x60,0x60,0,0}; memcpy(columnas,a,5); break;}
        case ':': {uint8_t a[5]={0,0x36,0x36,0,0}; memcpy(columnas,a,5); break;}
        case '%': {uint8_t a[5]={0x63,0x13,0x08,0x64,0x63}; memcpy(columnas,a,5); break;}
        case '-': {uint8_t a[5]={0x08,0x08,0x08,0x08,0x08}; memcpy(columnas,a,5); break;}
        case '/': {uint8_t a[5]={0x20,0x10,0x08,0x04,0x02}; memcpy(columnas,a,5); break;}

        default: break;
    }
}

static void TFT_Texto(
    uint16_t x,
    uint16_t y,
    const char *texto,
    uint16_t color,
    uint16_t fondo,
    uint8_t escala
)
{
    while (*texto)
    {
        char letra = *texto++;

        if (letra >= 'a' && letra <= 'z')
        {
            letra -= 32;
        }

        uint8_t columnas[5];

        TFT_ObtenerLetra(letra, columnas);

        TFT_Rectangulo(
            x,
            y,
            6 * escala,
            8 * escala,
            fondo
        );

        for (uint8_t col = 0; col < 5; col++)
        {
            for (uint8_t fila = 0; fila < 7; fila++)
            {
                if (columnas[col] & (1 << fila))
                {
                    TFT_Rectangulo(
                        x + col * escala,
                        y + fila * escala,
                        escala,
                        escala,
                        color
                    );
                }
            }
        }

        x += 6 * escala;

        if (x + 6 * escala > TFT_ANCHO)
        {
            break;
        }
    }
}

