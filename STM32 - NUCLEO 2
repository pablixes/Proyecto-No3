    );
}

static void TFT_Datos(
    const uint8_t *datos,
    uint16_t cantidad
)
{
    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_RESET
    );

    HAL_GPIO_WritePin(
        TFT_DC_GPIO_Port,
