// Interrupcion cuando llega un caracter desde Nucleo 1
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        uint16_t siguiente =
            (uint16_t)((uartRxHead + 1U) %
                       UART_RX_BUFFER_SIZE);

        if (siguiente != uartRxTail)
        {
            uartRxBuffer[uartRxHead] = uartRxByte;
            uartRxHead = siguiente;
        }
        else
        {
            uartOverflow = 1;
        }

        HAL_UART_Receive_IT(
            &huart1,
            &uartRxByte,
            1
        );
    }
}

// Recuperacion ante errores UART
void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART1)
    {
        uartError = 1;

        HAL_UART_Receive_IT(
            &huart1,
            &uartRxByte,
            1
        );
    }
}

// Obtener caracter almacenado
static uint8_t UART_ObtenerByte(uint8_t *dato)
{
    if (uartRxTail == uartRxHead)
    {
        return 0;
    }

    *dato = uartRxBuffer[uartRxTail];

    uartRxTail =
        (uint16_t)((uartRxTail + 1U) %
                   UART_RX_BUFFER_SIZE);

    return 1;
}

