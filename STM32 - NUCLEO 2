// ============================================================
// PARTE 1: SENSOR AHT10 POR I2C
// ============================================================

static void AHT10_Init(void)
{
    uint8_t comando[3] = {
        0xE1, 0x08, 0x00
    };

    sensorDisponible = 0;

    HAL_Delay(40);

    if (HAL_I2C_IsDeviceReady(
            &hi2c1,
            AHT10_ADDR,
            3,
            100
        ) == HAL_OK)
    {
        if (HAL_I2C_Master_Transmit(
                &hi2c1,
                AHT10_ADDR,
                comando,
                3,
                100
            ) == HAL_OK)
        {
            HAL_Delay(20);
            sensorDisponible = 1;
        }
    }
}

static uint8_t AHT10_Leer(void)
{
    uint8_t comando[3] = {
        0xAC, 0x33, 0x00
    };

    uint8_t datos[6];

    uint32_t datoHumedad;
    uint32_t datoTemperatura;

    // Solicitar medicion
    if (HAL_I2C_Master_Transmit(
            &hi2c1,
            AHT10_ADDR,
            comando,
            3,
            100
        ) != HAL_OK)
    {
        sensorDisponible = 0;
        return 0;
    }

    HAL_Delay(80);

    // Recibir los 6 bytes del AHT10
    if (HAL_I2C_Master_Receive(
            &hi2c1,
            AHT10_ADDR,
            datos,
            6,
            100
        ) != HAL_OK)
    {
        sensorDisponible = 0;
        return 0;
    }

    // Revisar bit de ocupado
    if (datos[0] & 0x80)
    {
        return 0;
    }

    // Extraer humedad
    datoHumedad =
        ((uint32_t)datos[1] << 12) |
        ((uint32_t)datos[2] << 4) |
        ((uint32_t)datos[3] >> 4);

    // Extraer temperatura
    datoTemperatura =
        (((uint32_t)datos[3] & 0x0F) << 16) |
        ((uint32_t)datos[4] << 8) |
        ((uint32_t)datos[5]);

    humedad =
        ((float)datoHumedad * 100.0f) /
        1048576.0f;

    temperatura =
        ((float)datoTemperatura * 200.0f) /
        1048576.0f - 50.0f;

    temperatura10 = (int32_t)(
        temperatura * 10.0f +
        (temperatura >= 0.0f ? 0.5f : -0.5f)
    );

    humedad10 = (int32_t)(
        humedad * 10.0f + 0.5f
    );

    medicionValida = 1;

    return 1;
}

// ============================================================
// PARTE 4: PRUEBA DEL AHT10 EN HERCULES
// ============================================================

static void Hercules_ProbarSensor(void)
{
    // Comprobar sensor cada 2 segundos
    if ((uint32_t)(HAL_GetTick() - tiempoAnteriorSensor)
        < INTERVALO_SENSOR_MS)
    {
        return;
    }

    tiempoAnteriorSensor = HAL_GetTick();

    // Comprobar si el sensor esta disponible
    if (!sensorDisponible)
    {
        Hercules_Enviar(
            "AHT10: Intentando inicializar sensor...\r\n"
        );

        AHT10_Init();
    }

    if (sensorDisponible && AHT10_Leer())
    {
        // Obtener valor absoluto de temperatura
        long temperaturaAbs =
            temperatura10 < 0
            ? -(long)temperatura10
            : (long)temperatura10;

        // Crear mensaje para Hercules
        snprintf(
            mensajeHercules,
            sizeof(mensajeHercules),
            "TEMPERATURA: %s%ld.%ld C | HUMEDAD: %ld.%ld %%\r\n",
            temperatura10 < 0 ? "-" : "",
            temperaturaAbs / 10,
            temperaturaAbs % 10,
            (long)(humedad10 / 10),
            (long)(humedad10 % 10)
        );

        // Mostrar la medicion en Hercules
        Hercules_Enviar(mensajeHercules);
    }
    else
    {
        Hercules_Enviar(
            "ERROR: AHT10 NO RESPONDE\r\n"
        );
    }
}


// ============================================================
// PARTE 5: MICROSD (SPI1 compartido con TFT, CS = PB6)
// Middleware FatFs -> User-defined. Driver: FATFS/Target/user_diskio.c
// Tarjeta de 64GB: FORMATEAR FAT32 (exFAT no sirve si FF_FS_EXFAT=0)
// No guardar si no existe una lectura valida.
// ============================================================
static FATFS fsSD;
static uint32_t numeroRegistro = 0;
static char sdError[48] = "SD_NO_PROBADA";

// Mantener informacion exacta del fallo para Hercules y Dabble.
static void SD_Error(const char *etapa, unsigned codigo)
{
    snprintf(sdError, sizeof(sdError), "SD_%s_%u", etapa, codigo);
    snprintf(mensajeHercules, sizeof(mensajeHercules),
             "SD ERROR: %s (codigo %u)\r\n", etapa, codigo);
    Hercules_Enviar(mensajeHercules);
}

static uint8_t sdGuardarUltima(void)
{
    FRESULT fr;
    FIL archivo;
    UINT escritos;
    uint8_t ok = 0;
    char registro[96];
    uint8_t nuevo;

    if (!medicionValida) {
        strcpy(sdError, "SIN_MEDICION");
        Hercules_Enviar("SD ERROR: SIN MEDICION VALIDA\r\n");
        return 0;
    }

    // El display y la microSD comparten SPI1 pero NO chip select.
    HAL_GPIO_WritePin(TFT_CS_GPIO_Port, TFT_CS_Pin, GPIO_PIN_SET);
    HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET);
    Hercules_Enviar("SD: montando FAT32...\r\n");

    // MX_FATFS_Init() debe haber vinculado USER_Driver con unidad 0.
    fr = f_mount(&fsSD, "0:", 1);
    if (fr != FR_OK) {
        SD_Error("MOUNT", (unsigned)fr);
        (void)f_mount(NULL, "0:", 0);
        return 0;
    }
    Hercules_Enviar("SD: FAT32 montado\r\n");

    fr = f_open(&archivo, "0:/DATOS.CSV", FA_OPEN_ALWAYS | FA_WRITE);
    if (fr != FR_OK) {
        SD_Error("OPEN", (unsigned)fr);
        goto desmontar;
    }

    nuevo = (f_size(&archivo) == 0U);
    fr = f_lseek(&archivo, f_size(&archivo));
    if (fr != FR_OK) {
        SD_Error("SEEK", (unsigned)fr);
        goto cerrar;
    }

    if (nuevo) {
        static const char encabezado[] =
            "registro,temperatura_C,humedad_porcentaje\r\n";
        escritos = 0;
        fr = f_write(&archivo, encabezado,
                     (UINT)strlen(encabezado), &escritos);
        if (fr != FR_OK || escritos != strlen(encabezado)) {
            SD_Error("HEADER", (unsigned)(fr != FR_OK ? fr : 255U));
            goto cerrar;
        }
    }

    // Representacion entera (decimas), sin depender de printf float.
    long tv = (long)temperatura10;
    long hv = (long)humedad10;
    unsigned long ta = tv < 0 ? (unsigned long)(-(int64_t)tv) : (unsigned long)tv;
    unsigned long ha = hv < 0 ? (unsigned long)(-(int64_t)hv) : (unsigned long)hv;
    snprintf(registro, sizeof(registro),
             "%lu,%s%lu.%lu,%s%lu.%lu\r\n",
             (unsigned long)(numeroRegistro + 1U),
             tv < 0 ? "-" : "", ta/10UL, ta%10UL,
             hv < 0 ? "-" : "", ha/10UL, ha%10UL);

    escritos = 0;
    fr = f_write(&archivo, registro, (UINT)strlen(registro), &escritos);
    if (fr != FR_OK || escritos != strlen(registro)) {
        SD_Error("WRITE", (unsigned)(fr != FR_OK ? fr : 255U));
        goto cerrar;
    }
    fr = f_sync(&archivo);
    if (fr != FR_OK) {
        SD_Error("SYNC", (unsigned)fr);
        goto cerrar;
    }
    ok = 1;

cerrar:
    fr = f_close(&archivo);
    if (fr != FR_OK) {
        SD_Error("CLOSE", (unsigned)fr);
        ok = 0;
    }
desmontar:
    (void)f_mount(NULL, "0:", 0);
    HAL_GPIO_WritePin(SD_CS_GPIO_Port, SD_CS_Pin, GPIO_PIN_SET);
    if (ok) {
        numeroRegistro++;
        strcpy(sdError, "OK");
        Hercules_Enviar("SD: DATOS.CSV guardado correctamente\r\n");
    }
    return ok;
}

// ============================================================
// PARTE 2: PROCESAR COMANDOS DE NUCLEO 1
// ============================================================

static void UART_ProcesarComando(const char *comando)
{
    // RESPUESTA A IDENTIFICACION DE NUCLEO 1:
    // la Nucleo 2 actua como SLAVE LOGICO POR UART.
    // No utilizar una direccion I2C 0x32 en este enlace.
    if (strcmp(comando, "PING") == 0 ||
        strcmp(comando, "HELLO") == 0)
    {
        Hercules_Enviar("UART1: PING recibido; enviando ACK\r\n");
        UART_Enviar("ACK,NUCLEO2\n");
        return;
    }
    // --------------------------------------------------------
    // COMANDO LECTURA
    // --------------------------------------------------------

    if (strcmp(comando, "READ") == 0 ||
        strcmp(comando, "LECTURA") == 0)
    {
        // Confirmar llegada del comando por Hercules
        Hercules_Enviar(
            "UART1: Comando READ recibido de Nucleo 1\r\n"
        );

        // Confirmacion temporal para Nucleo 1
        UART_Enviar("ACK,READ\n");

        if (!sensorDisponible)
        {
            AHT10_Init();
        }

        if (sensorDisponible && AHT10_Leer())
        {
            // Enviar temperatura y humedad a Nucleo 1
            snprintf(
                mensajeUART,
                sizeof(mensajeUART),
                "DATA,%ld,%ld\n",
                (long)temperatura10,
                (long)humedad10
            );

            UART_Enviar(mensajeUART);

            // Mostrar los valores tambien en Hercules (solo tras READ)
            snprintf(mensajeHercules,sizeof(mensajeHercules),
                "LECTURA: T=%ld.%ld C H=%ld.%ld %%\r\n",
                (long)(temperatura10/10),(long)(temperatura10<0?-temperatura10%10:temperatura10%10),
                (long)(humedad10/10),(long)(humedad10%10));
            Hercules_Enviar(mensajeHercules);

            // Mostrar valores en pantalla
            TFT_ActualizarDatos();
        }
        else
        {
            UART_Enviar(
                "ERR,AHT10_NO_RESPONDE\n"
            );

            Hercules_Enviar(
                "ERROR UART1: Sensor AHT10 no responde\r\n"
            );
        }
    }

    // --------------------------------------------------------
    // COMANDO GUARDAR
    // --------------------------------------------------------

    else if (strcmp(comando, "SAVE") == 0 ||
             strcmp(comando, "GUARDAR") == 0)
    {
        Hercules_Enviar(
            "UART1: Comando SAVE recibido\r\n"
        );

        if (!medicionValida)
        {
            UART_Enviar("ERR,SIN_MEDICION_PARA_GUARDAR\n");
        }
        else if(sdGuardarUltima())
        {
            UART_Enviar("SAVED\n");
        }
        else
        {
            snprintf(mensajeUART, sizeof(mensajeUART), "ERR,%s\n", sdError);
            UART_Enviar(mensajeUART);
        }
    }
    else
    {
        UART_Enviar(
            "ERR,COMANDO_DESCONOCIDO\n"
        );
    }
}

// ============================================================
// PARTE 2: REVISAR DATOS UART DE NUCLEO 1
// ============================================================

static void UART_Revisar(void)
{
    uint8_t dato;

    if (uartOverflow)
    {
        uartOverflow = 0;
        posicionUART = 0;

        UART_Enviar(
            "ERR,UART_BUFFER_LLENO\n"
        );
    }

    if (uartError)
    {
        uartError = 0;

        UART_Enviar(
            "ERR,UART_RECEPCION\n"
        );
    }

    while (UART_ObtenerByte(&dato))
    {
        if (dato == '\r')
        {
            continue;
        }

        if (dato == '\n')
        {
            comandoUART[posicionUART] = '\0';

            if (posicionUART > 0)
            {
                snprintf(mensajeHercules,sizeof(mensajeHercules),
                 "DIAG N2: USART1 RECIBIO [%s]\r\n",comandoUART);
                Hercules_Enviar(mensajeHercules);
                UART_ProcesarComando(comandoUART);
            }

            posicionUART = 0;
        }
        else if (dato >= 32 && dato <= 126 &&
                 posicionUART < sizeof(comandoUART) - 1)
        {
            comandoUART[posicionUART++] = (char)dato;
        }
        else
        {
            posicionUART = 0;
            Hercules_Enviar("UART1: caracter invalido o comando largo\r\n");
        }
    }
}

