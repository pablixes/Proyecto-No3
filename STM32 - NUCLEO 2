static void TFT_Comando(uint8_t comando)
{
    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_RESET
    );

    HAL_GPIO_WritePin(
        TFT_DC_GPIO_Port,
