}

static void TFT_Ventana(
    uint16_t x0,
    uint16_t y0,
    uint16_t x1,
    uint16_t y1
)
{
    uint8_t datos[4];

    TFT_Comando(0x2A);

    datos[0] = x0 >> 8;
    datos[1] = x0 & 0xFF;
    datos[2] = x1 >> 8;
    datos[3] = x1 & 0xFF;

    TFT_Datos(datos, 4);

    TFT_Comando(0x2B);

    datos[0] = y0 >> 8;
    datos[1] = y0 & 0xFF;
    datos[2] = y1 >> 8;
    datos[3] = y1 & 0xFF;

    TFT_Datos(datos, 4);

    TFT_Comando(0x2C);
}

// Dibujar rectangulos
static void TFT_Rectangulo(
    uint16_t x,
    uint16_t y,
    uint16_t ancho,
    uint16_t alto,
    uint16_t color
)
{
    if (x >= TFT_ANCHO || y >= TFT_ALTO)
    {
        return;
    }

    if (x + ancho > TFT_ANCHO)
    {
        ancho = TFT_ANCHO - x;
    }

    if (y + alto > TFT_ALTO)
    {
        alto = TFT_ALTO - y;
    }

    if (ancho == 0 || alto == 0)
    {
        return;
    }

    TFT_Ventana(
        x,
        y,
        x + ancho - 1,
        y + alto - 1
    );

    uint8_t buffer[128];

    for (uint16_t i = 0; i < 64; i++)
    {
        buffer[2 * i] = color >> 8;
        buffer[2 * i + 1] = color & 0xFF;
    }

    uint32_t pixeles =
        (uint32_t)ancho * alto;

    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_RESET
    );

    HAL_GPIO_WritePin(
        TFT_DC_GPIO_Port,
        TFT_DC_Pin,
        GPIO_PIN_SET
    );

    while (pixeles > 0)
    {
        uint16_t bloque =
            (pixeles > 64) ? 64 : (uint16_t)pixeles;

        HAL_SPI_Transmit(
            &hspi1,
            buffer,
            bloque * 2,
            1000
        );

        pixeles -= bloque;
    }

    HAL_GPIO_WritePin(
        TFT_CS_GPIO_Port,
        TFT_CS_Pin,
        GPIO_PIN_SET
    );
}

