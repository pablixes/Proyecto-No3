// ============================================================
// INTERFAZ PASTEL 320x240 - basada en la referencia del equipo
// Se conserva controlador ILI9341 y fuente 5x7.
// ============================================================
#define UI_FONDO 0xDFFF
#define UI_BARRA 0xCF3F
#define UI_SOMBRA 0xB5D9
#define UI_BLANCO 0xFFFF
#define UI_OSCURO 0x110B
#define UI_AZUL 0x24B8
#define UI_ROSA 0xF392
#define UI_CYAN 0x5E7C
#define UI_VERDE_F 0xBF97
#define UI_VERDE_T 0x058A
#define UI_ROJO_F 0xFDD6

static void UI_Linea(int x0,int y0,int x1,int y1,uint16_t color,uint8_t grosor){
  int dx=(x1>x0)?x1-x0:x0-x1, sx=x0<x1?1:-1;
  int dy=-((y1>y0)?y1-y0:y0-y1), sy=y0<y1?1:-1;
  int err=dx+dy;
  for(;;){if(x0>=0&&y0>=0)TFT_Rectangulo((uint16_t)x0,(uint16_t)y0,grosor,grosor,color);
    if(x0==x1&&y0==y1)break;
    int e=2*err; if(e>=dy){err+=dy;x0+=sx;} if(e<=dx){err+=dx;y0+=sy;}}
}
static void UI_Circulo(int cx,int cy,int r,uint16_t col){
  // Circulo relleno por franjas horizontales
  for(int y=-r;y<=r;y++){
    int x=0;while((x+1)*(x+1)+y*y<=r*r)x++;
    if(cx-x>=0&&cy+y>=0)TFT_Rectangulo(cx-x,cy+y,2*x+1,1,col);
  }
}
static void UI_Card(int x,int y,int w,int h){
  TFT_Rectangulo(x+3,y+4,w,h,UI_SOMBRA);
  TFT_Rectangulo(x,y,w,h,UI_BLANCO);
  UI_Circulo(x+7,y+7,7,UI_BLANCO);
  UI_Circulo(x+w-8,y+7,7,UI_BLANCO);
  UI_Circulo(x+7,y+h-8,7,UI_BLANCO);
  UI_Circulo(x+w-8,y+h-8,7,UI_BLANCO);
}
static void UI_Corazon(int x,int y,int r,uint16_t col){
  UI_Circulo(x-r/2,y-r/2,r/2,col);
  UI_Circulo(x+r/2,y-r/2,r/2,col);
  for(int k=0;k<=r;k++)UI_Linea(x-r+k,y-r/3+k,x+r-k,y-r/3+k,col,1);
}
static void UI_Bebe(int cx,int cy){
  UI_Circulo(cx,cy,17,UI_AZUL);
  UI_Circulo(cx,cy,15,0xFE9A);    // piel suave
  UI_Circulo(cx-5,cy-1,1,UI_OSCURO);
  UI_Circulo(cx+5,cy-1,1,UI_OSCURO);
  UI_Linea(cx-3,cy+6,cx,cy+8,UI_OSCURO,1);
  UI_Linea(cx,cy+8,cx+3,cy+6,UI_OSCURO,1);
  UI_Circulo(cx-9,cy+5,3,UI_ROSA);
  UI_Circulo(cx+9,cy+5,3,UI_ROSA);
  UI_Corazon(cx+19,cy-14,8,UI_ROSA);
}
static void UI_Termometro(int x,int y){
  TFT_Rectangulo(x,y,6,15,UI_AZUL);
  TFT_Rectangulo(x+2,y+2,2,15,UI_ROSA);
  UI_Circulo(x+3,y+18,6,UI_ROSA);
}
static void UI_Gota(int x,int y){
  UI_Circulo(x,y+13,9,UI_CYAN);
  UI_Linea(x-8,y+11,x,y-3,UI_CYAN,2);
  UI_Linea(x+8,y+11,x,y-3,UI_CYAN,2);
  UI_Circulo(x,y+13,6,0xC7FF);
}
static void UI_Incubadora(void){
