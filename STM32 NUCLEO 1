// ============================================================
// PROTOCOLO UART
// ESP32 -> Nucleo 1: LECTURA, GUARDAR
// Nucleo 1 -> Nucleo 2: READ, SAVE
// Nucleo 2 -> Nucleo 1: DATA,T10,H10 / SAVED / ERR,x
// ============================================================
static void ringPush(Ring *q,uint8_t b){uint16_t nx=(q->wr+1U)%RING_CAP;
  if(nx==q->rd){q->over=1;return;} q->data[q->wr]=b;q->wr=nx;}
static uint8_t ringPop(Ring *q,uint8_t *out){if(q->rd==q->wr)return 0;
  *out=q->data[q->rd];q->rd=(q->rd+1U)%RING_CAP;return 1;}
static void sendU(UART_HandleTypeDef *h,const char *s){
  HAL_UART_Transmit(h,(uint8_t*)s,(uint16_t)strlen(s),300);
}
static void report(const char *s){sendU(&huart2,s);sendU(&huart1,s);}

// ============================================================
// DAC AUDIO - TIM6 SOLO DURANTE UN COMANDO
// APB1 /4: PCLK1=21 MHz, TIM6CLK=42 MHz (por multiplicador x2)
// PSC=20, ARR=124 => 42 MHz / (21 * 125) = 16000 Hz
// DAC PA4 (A2) -> capacitor de acoplo -> LM386 -> bocina
// ============================================================
void TIM6_DAC_IRQHandler(void){HAL_TIM_IRQHandler(&htim6app);}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim){
  if(htim->Instance!=TIM6) return;
  uint32_t step=sfxStep;
  if(step==0U){
    HAL_DAC_SetValue(&hdac,DAC_CHANNEL_1,DAC_ALIGN_12B_R,0U);
    return;
  }
  sfxPhase+=step;
  uint16_t saw=(uint16_t)(sfxPhase >> 20);
  uint16_t tri=(saw < 2048U)?saw:(4095U-saw);
  uint32_t val=950U+(uint32_t)tri;
  HAL_DAC_SetValue(&hdac,DAC_CHANNEL_1,DAC_ALIGN_12B_R,val);
}

static void audioInit(void){
  __HAL_RCC_TIM6_CLK_ENABLE();
  htim6app.Instance=TIM6;
  // Con APB1 dividido entre 4, TIM6 funciona a 42 MHz.
  htim6app.Init.Prescaler=20U;
  htim6app.Init.CounterMode=TIM_COUNTERMODE_UP;
  htim6app.Init.Period=124U;
  htim6app.Init.AutoReloadPreload=TIM_AUTORELOAD_PRELOAD_DISABLE;
  if(HAL_TIM_Base_Init(&htim6app)!=HAL_OK)Error_Handler();
  if(HAL_DAC_Start(&hdac,DAC_CHANNEL_1)!=HAL_OK)Error_Handler();
  HAL_DAC_SetValue(&hdac,DAC_CHANNEL_1,DAC_ALIGN_12B_R,0U);
  HAL_NVIC_SetPriority(TIM6_DAC_IRQn,6,0);
  HAL_NVIC_EnableIRQ(TIM6_DAC_IRQn);
  // NO iniciar TIM6 aqui. La bocina queda en silencio.
}

static void audioNote(uint16_t hz){
  if(hz==0U){
    sfxStep=0;
    HAL_DAC_SetValue(&hdac,DAC_CHANNEL_1,DAC_ALIGN_12B_R,0U);
    return;
  }
  uint32_t step=(uint32_t)(((uint64_t)hz<<32)/SFX_SAMPLE_RATE);
  __disable_irq();
  sfxPhase=0;
  sfxStep=step;
  __enable_irq();
}

static void audioStop(void){
  HAL_TIM_Base_Stop_IT(&htim6app);
  sfxStep=0;
  sfxPhase=0;
  sfxNotas=NULL;
  sfxTotal=0;
  sfxIndice=0;
  HAL_DAC_SetValue(&hdac,DAC_CHANNEL_1,DAC_ALIGN_12B_R,0U);
}

static void audioPlay(const Nota *notes,uint8_t n){
  if(notes==NULL || n==0U)return;
  // Reiniciar audio solo ante un nuevo comando valido.
  HAL_TIM_Base_Stop_IT(&htim6app);
  HAL_DAC_SetValue(&hdac,DAC_CHANNEL_1,DAC_ALIGN_12B_R,0U);
  sfxNotas=notes;
  sfxTotal=n;
  sfxIndice=0;
  audioNote(notes[0].hz);
  sfxHasta=HAL_GetTick()+notes[0].ms;
  __HAL_TIM_SET_COUNTER(&htim6app,0);
  if(HAL_TIM_Base_Start_IT(&htim6app)!=HAL_OK)Error_Handler();
}

static void audioTick(void){
  if(!sfxNotas || (int32_t)(HAL_GetTick()-sfxHasta)<0)return;
  sfxIndice++;
  if(sfxIndice>=sfxTotal){
    audioStop();
    return;
  }
  audioNote(sfxNotas[sfxIndice].hz);
  sfxHasta=HAL_GetTick()+sfxNotas[sfxIndice].ms;
}

