static void neoColor(uint8_t r,uint8_t g,uint8_t b){
  neoR=r;neoG=g;neoB=b;neoChanged=1;
}
static void neoTick(void){
  if(!neoChanged || neoBusy) return;
  neoChanged=0;
  uint32_t rgb=((uint32_t)neoG<<16)|((uint32_t)neoR<<8)|neoB;
  for(uint8_t i=0;i<24U;i++){
    neoPwm[i]=(rgb&(1UL<<(23U-i)))?NEO_DUTY_1:NEO_DUTY_0;
  }
  for(uint8_t i=24U;i<sizeof(neoPwm)/sizeof(neoPwm[0]);i++)neoPwm[i]=0;
  neoBusy=1;
  __HAL_TIM_SET_COUNTER(&htim1,0);
  if(HAL_TIM_PWM_Start_DMA(&htim1,TIM_CHANNEL_1,
      (uint32_t*)neoPwm,(uint16_t)(sizeof(neoPwm)/sizeof(neoPwm[0])))!=HAL_OK){
    neoBusy=0;
  }
}
static void stateIdle(void){neoColor(0,22,3);}
static void stateRead(void){neoColor(0,12,28);}
static void stateSend(void){neoColor(0,0,30);}
static void stateSave(void){neoColor(24,0,20);}
static void stateError(void){neoColor(38,0,0);}
static void stateHold(uint32_t ms){neoUntil=HAL_GetTick()+ms;}

// ============================================================
// ENLACE UART CON NUCLEO 2 (SLAVE LOGICO)
// Una UART no tiene direccion 0x32 ni esclavo fisico.
// PING -> ACK,NUCLEO2; antes de READ/SAVE se verifica enlace.
// pending: 0 libre; 1 lectura; 2 guardado; 3 PING;
//          4 esperando ACK antes READ; 5 antes SAVE.
// ============================================================
static void commandFromESP(const char *c){
  if(strcmp(c,"PRUEBA")==0){
    report("NUCLEO 1 FUNCIONA\r\n");
    return;
  }
  if(strcmp(c,"PING")==0){
    pending=3;pendingSince=HAL_GetTick();
    report("NUCLEO 1 RECIBIO PING\r\n");
    sendU(&huart3,"PING\n");
    report("PING ENVIADO A NUCLEO 2\r\n");
    return;
  }
  if(pending){
    report("AVISO: OPERACION EN CURSO, ESPERE\r\n");
    return;
  }
  if(strcmp(c,"LECTURA")==0 || strcmp(c,"READ")==0){
    pending=4;pendingSince=HAL_GetTick();stateRead();
    audioPlay(sonidoLectura,sizeof(sonidoLectura)/sizeof(Nota));
    report("NUCLEO 1 RECIBIO LECTURA\r\n");
    report("VERIFICANDO ENLACE UART CON NUCLEO 2\r\n");
    sendU(&huart3,"PING\n");
  } else if(strcmp(c,"GUARDAR")==0 || strcmp(c,"SAVE")==0){
    pending=5;pendingSince=HAL_GetTick();stateSave();
    audioPlay(sonidoGuardar,sizeof(sonidoGuardar)/sizeof(Nota));
    report("NUCLEO 1 RECIBIO GUARDAR\r\n");
    sendU(&huart3,"PING\n");
  } else report("ERROR: COMANDO DESCONOCIDO\r\n");
}
static void responseFromN2(const char *s){
  // Confirmacion de enlace, equivalente al handshake del profesor,
  // pero para UART en vez de I2C o SPI.
  if(strcmp(s,"ACK,NUCLEO2")==0){
    report("ENLACE UART OK: NUCLEO 2 RESPONDIO\r\n");
    if(pending==4){
      pending=1;pendingSince=HAL_GetTick();
      sendU(&huart3,"READ\n");
      report("NUCLEO 1 ENVIO READ A NUCLEO 2\r\n");
    } else if(pending==5){
      pending=2;pendingSince=HAL_GetTick();
      sendU(&huart3,"SAVE\n");
      report("NUCLEO 1 ENVIO SAVE A NUCLEO 2\r\n");
    } else if(pending==3){
      pending=0;
      report("PING CORRECTO: ESP32 - N1 - N2\r\n");
    }
    return;
  }
  long t10,h10;
  if(sscanf(s,"DATA,%ld,%ld",&t10,&h10)==2){
    if(pending!=1){report("AVISO: DATA SIN SOLICITUD\r\n");return;}
    unsigned long at=t10<0?(unsigned long)(-(int64_t)t10):(unsigned long)t10;
    unsigned long ah=h10<0?(unsigned long)(-(int64_t)h10):(unsigned long)h10;
    snprintf(salida,sizeof(salida),"TEMPERATURA: %s%lu.%lu C | HUMEDAD: %s%lu.%lu %%\r\n",
      t10<0?"-":"",at/10UL,at%10UL,h10<0?"-":"",ah/10UL,ah%10UL);
    report(salida);pending=0;stateSend();stateHold(950);
  } else if(strcmp(s,"SAVED")==0){
    report("GUARDADO OK: DATOS.CSV EN MICROSD\r\n");
    pending=0;stateSave();stateHold(1300);
  } else if(strncmp(s,"ERR,",4)==0){
    snprintf(salida,sizeof(salida),"ERROR NUCLEO 2: %s\r\n",s+4);
    report(salida);pending=0;stateError();stateHold(1900);
  } else if(strncmp(s,"ACK,",4)==0){
    snprintf(salida,sizeof(salida),"NUCLEO 2: %s\r\n",s+4);
    report(salida);
  } else {
    snprintf(salida,sizeof(salida),"NUCLEO 2 MENSAJE: %s\r\n",s);
    report(salida);
  }
}
static void readPort(Ring *q,char *buf,uint8_t *n,uint8_t limit,uint8_t esp){
  uint8_t b;
  if(q->over){q->over=0;*n=0;report("AVISO: BUFFER UART LLENO\r\n");}
  while(ringPop(q,&b)){
    if(b=='\r')continue;
    if(b=='\n'){
      buf[*n]=0;
      if(*n){if(esp)commandFromESP(buf);else responseFromN2(buf);}
      *n=0;
    }else if(b>=32 && b<=126 && *n<limit-1U){buf[(*n)++]=(char)b;}
    else {*n=0;}
  }
}
